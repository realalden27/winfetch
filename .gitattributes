# Default everything to binary/LF protection
* -text

# Text files with explicit LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff2 binary
*.wasm binary
